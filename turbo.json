{
	"$schema": "https://turbo.build/schema.json",
	"ui": "tui",
	"tasks": {
		"dev": {
			"cache": false,
			"persistent": true
		},
		"build": {
			"cache": true,
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"typecheck": {
			"cache": false,
			"dependsOn": ["^build"]
		},
		"lint": {
			"cache": true,
			"dependsOn": ["^lint"]
		},
		"test": {
			"cache": false,
			"dependsOn": ["^build"]
		}
	}
}
