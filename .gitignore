# Node modules
node_modules/
*/node_modules/
.pnpm-store/

# Build outputs
dist/
*/dist/
build/
*/build/
.next/
.tanstack/
*/.tanstack/
coverage/
*.tsbuildinfo

# Turborepo cache
.turbo/
*/.turbo/

# Logs
logs/
*.log
npm-debug.log*

# Environment files
.env
.env.*
env/**/.env*

# Exception: these three are the committed *local dev* env files (see
# docs/decisions.md #15). Every value in them is generated fresh for this
# repo and grants no access outside your own local docker-compose stack —
# no real external credentials (SMTP/OAuth/etc.) ever belong here. Any
# .env file NOT in this allowlist stays gitignored.
!api/.env
!web/.env
!env/development/.env.database

# OS generated files
.DS_Store
Thumbs.db

# IDE / editor files
.idea/
*.sublime-workspace
*.sublime-project

# Docker files
*.env.docker

# Misc
*.swp
*.tmp
*.bak
