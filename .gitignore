# Node modules
node_modules/
*/node_modules/
.pnpm-store/

# Build outputs
dist/
*/dist/
build/
*/build/
.next/
.tanstack/
*/.tanstack/
coverage/
*.tsbuildinfo

# Turborepo cache
.turbo/
*/.turbo/

# Logs
logs/
*.log
npm-debug.log*

# Environment files
.env
.env.*
env/**/.env*

# Exception: these are the committed env files (see docs/decisions.md #15,
# #20). Every secret-shaped value in them is blank; the non-secret values
# grant no access outside your own local docker-compose stack. Real values
# live only in the gitignored `*.local` counterparts. Any .env file NOT in
# this allowlist stays gitignored.
!api/.env
!web/.env
!env/development/.env.database
!api/.env.production
!web/.env.production
!env/production/.env.database

# OS generated files
.DS_Store
Thumbs.db

# IDE / editor files
.idea/
*.sublime-workspace
*.sublime-project

# Docker files
*.env.docker

# Misc
*.swp
*.tmp
*.bak
