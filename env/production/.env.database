# POSTGRES_USER/POSTGRES_DB aren't secret. POSTGRES_PASSWORD is, left blank
# on purpose — set via env/production/.env.local.database (gitignored) for a
# local production dry-run. Real production uses managed Postgres and never
# reads this file. See README.md "Production dry-run".
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=transaction-dispute
