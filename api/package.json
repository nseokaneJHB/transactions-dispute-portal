{
	"private": true,
	"type": "module",
	"version": "0.0.1",
	"name": "@transaction-dispute-portal/api",
	"scripts": {
		"dev": "tsx watch src/app.ts",
		"build": "tsc",
		"start": "node dist/app.js",
		"typecheck": "tsc --noEmit",
