		"@transaction-dispute-portal/shared": "workspace:*",
		"better-auth": "1.7.2",
		"drizzle-orm": "0.45.2",
		"fastify": "5.8.5",
		"nodemailer": "8.0.7",
		"postgres": "3.4.9",
		"uuid": "14.0.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@types/node": "25.8.0",
		"@types/nodemailer": "8.0.0",
		"drizzle-kit": "0.31.10",
		"tsx": "4.21.0",
		"typescript": "6.0.3"
	}
}
