PORT=8080
NODE_ENV=development
LOG_LEVEL=debug

CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Database
DATABASE_URL=postgresql://postgres:changeme@localhost:5432/transaction-dispute-portal

# Better Auth — generate real values with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-with-openssl-rand-base64-32
COOKIE_SECRET=replace-with-openssl-rand-base64-32

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

# Internal-only routes (POST /internal/disputes/:id/resolve) — see docs/api.md
INTERNAL_API_TOKEN=replace-with-openssl-rand-base64-32
