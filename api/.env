PORT=8080
API_VERSION=v1
LOG_LEVEL=debug
NODE_ENV=development

CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Database — secret (embeds the Postgres password), left blank on purpose.
# Fill in via api/.env.local (gitignored) — see README.md "Local setup".
# Inside docker-compose, the DB host is the service name, not localhost:
#   postgresql://postgres:<POSTGRES_PASSWORD>@transaction-dispute-portal-database:5432/transaction-dispute
# <POSTGRES_PASSWORD> must match env/development/.env.local.database.
DATABASE_URL=

# Better Auth — secrets, left blank on purpose. Generate with
# `openssl rand -base64 32` and set via api/.env.local (gitignored).
BETTER_AUTH_SECRET=
COOKIE_SECRET=

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

# Outbound SMTP — real, working default: the local Mailpit catcher
# (compose.yml), no auth needed, nothing secret about it. Only fill in
# api/.env.local (gitignored) if you want mail to land in a real inbox
# instead — see docs/decisions.md #19/#20.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@transaction-dispute-portal.local
