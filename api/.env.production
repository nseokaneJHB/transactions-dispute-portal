# Production API config. Non-secret operational values are real; every
# secret-shaped key is blank on purpose (docs/decisions.md #20).
#
# For a local production dry-run, fill the blanks in api/.env.production.local
# (gitignored) — see README.md "Production dry-run". Real production injects
# these from the orchestrator's config/secret store, not from a file.

PORT=8080
API_VERSION=v1
LOG_LEVEL=info
NODE_ENV=production

API_URL=https://api.portal.example.com
CORS_ORIGIN=https://portal.example.com
FRONTEND_URL=https://portal.example.com

# Secrets — blank on purpose.
DATABASE_URL=
BETTER_AUTH_SECRET=
COOKIE_SECRET=

# Rate limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=60

# Outbound SMTP — a real transactional provider in production. Host/user/pass
# are secret-shaped and blank; port/from are not.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@portal.example.com
